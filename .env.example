# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE CUESTIONARIOS Y PROCTORING IA
# ==============================================================================
# Copia este archivo como .env y completa las credenciales correspondientes.
# 
#   cp .env.example .env
#
# ==============================================================================

# ── 1. Base de Datos PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/cuestionarios_db"

# ── 2. Autenticación (Auth.js / NextAuth) ────────────────────────────────────
# Secreto para firmar tokens JWT. Genera uno con: openssl rand -base64 32
AUTH_SECRET="reemplazar_con_un_secreto_seguro_base64"

# ── 3. Google Generative AI (Gemini) ─────────────────────────────────────────
# Clave API de Google AI Studio necesaria para la supervisión visual con cámara.
# Consíguela en: https://aistudio.google.com/
GEMINI_API_KEY="TU_API_KEY_DE_GEMINI_AQUI"

# Modelo de IA utilizado para el proctoring visual (Fijo: gemini-2.5-flash)
GEMINI_PROCTORING_MODEL="gemini-2.5-flash"

# ── 4. Captura de Cámara (Intervalos Aleatorios en Segundos) ──────────────────
# Intervalo mínimo y máximo en segundos para tomar fotos aleatorias de la cámara.
# (Nota: La 1ª captura rápida se realiza siempre a los 3 segundos de iniciar).
PROCTORING_CAPTURE_MIN_SECONDS=45
PROCTORING_CAPTURE_MAX_SECONDS=70

# ── 5. Detección de Ruido y Audio (Valores Fijos del Sistema) ─────────────────
# Milisegundos sostenidos de ruido vocal antes de generar una falta (3000ms = 3s)
NOISE_SUSTAINED_MS=3000

# Milisegundos de audio .webm que se graban como evidencia (5000ms = 5s)
NOISE_RECORDING_MS=5000

# Cooldown en milisegundos entre alertas de ruido (5000ms = 5s de recarga)
NOISE_COOLDOWN_MS=5000

# Duración de la calibración inicial de silencio al arrancar el examen (5000ms = 5s)
NOISE_CALIBRATION_MS=5000

# -- 6. Almacenamiento privado de evidencias en Google Drive -------------------
# ID de la carpeta privada donde se guardaran las capturas y grabaciones.
# Es la parte que aparece despues de /folders/ en la URL de Google Drive.
GOOGLE_DRIVE_FOLDER_ID="ID_DE_LA_CARPETA"

# Opcion A (recomendada para una cuenta personal de Google): OAuth 2.0.
GOOGLE_DRIVE_CLIENT_ID="CLIENT_ID.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="CLIENT_SECRET"
GOOGLE_DRIVE_REFRESH_TOKEN="REFRESH_TOKEN"

# Opcion B (Google Workspace / Shared Drive): cuenta de servicio.
# No completes estas dos variables si utilizas la opcion OAuth anterior.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL="cuenta@proyecto.iam.gserviceaccount.com"
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
