generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Rol {
  ADMIN
  USUARIO
}

enum TipoPregunta {
  OPCION_MULTIPLE
  ABIERTA
}

enum EstadoIntento {
  EN_PROGRESO // El usuario está respondiendo
  PAUSADO_REVISION_IA // Pausado temporalmente por una alerta de proctoring pendiente
  REACTIVADO_POR_ADMIN // Reactivado por admin/profesor tras falso positivo
  CANCELADO_CONFIRMADO // Cancelado por confirmación humana de irregularidad
  ENVIADO // El usuario entregó, pendiente de calificar preguntas abiertas
  CALIFICADO // Todas las preguntas están calificadas, calificacion final guardada
}

enum NivelAlertaProctoring {
  BAJO
  MEDIO
  ALTO
}

enum EstadoRevisionProctoring {
  PENDIENTE
  CONFIRMADA
  ANULADA_FALSO_POSITIVO
  ERROR_IA
}

enum TipoEvidenciaProctoring {
  SNAPSHOT_CAMARA
  GRABACION_RUIDO
}

// ─────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────

// Todos los usuarios del sistema: admins y usuarios regulares
model Usuario {
  id       String   @id @default(cuid())
  nombre   String
  email    String   @unique
  password String
  rol      Rol      @default(USUARIO)
  creadoEn DateTime @default(now())

  // Relaciones
  cuestionarios              Cuestionario[] // Cuestionarios que creó (solo admins)
  gruposCreados              Grupo[]
  membresiasGrupo            GrupoMiembro[]
  intentos                   Intento[] // Intentos de cuestionarios (solo usuarios regulares)
  alertasProctoring          AlertaProctoring[] @relation("AlertaProctoringEstudiante")
  alertasProctoringRevisadas AlertaProctoring[] @relation("AlertaProctoringRevisor")
}

// Cuestionario creado por un administrador
model Cuestionario {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String?
  adminId     String // Admin que creó el cuestionario
  grupoId     String?
  creadoEn    DateTime @default(now())

  // Relaciones
  admin     Usuario    @relation(fields: [adminId], references: [id])
  grupo     Grupo?     @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  preguntas Pregunta[]
  intentos  Intento[]

  @@index([grupoId])
}

// Materia o grupo creado por un administrador.
model Grupo {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  codigo      String   @unique
  adminId     String
  creadoEn    DateTime @default(now())

  admin         Usuario        @relation(fields: [adminId], references: [id])
  miembros      GrupoMiembro[]
  cuestionarios Cuestionario[]

  @@index([adminId])
}

// Inscripcion de un alumno a una materia o grupo.
model GrupoMiembro {
  id        String   @id @default(cuid())
  grupoId   String
  usuarioId String
  unidoEn   DateTime @default(now())

  grupo   Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
}

// Pregunta dentro de un cuestionario
// Puede ser de opción múltiple o abierta
model Pregunta {
  id             String       @id @default(cuid())
  cuestionarioId String
  texto          String
  tipo           TipoPregunta
  puntos         Float // Puntaje máximo que vale esta pregunta
  orden          Int // Orden de aparición en el cuestionario

  // Relaciones
  cuestionario Cuestionario @relation(fields: [cuestionarioId], references: [id])
  opciones     Opcion[] // Solo aplica si tipo = OPCION_MULTIPLE
  respuestas   Respuesta[]
}

// Opciones de respuesta para preguntas de opción múltiple
// Una sola opción por pregunta tiene esCorrecta = true
model Opcion {
  id         String  @id @default(cuid())
  preguntaId String
  texto      String
  esCorrecta Boolean @default(false)

  // Relaciones
  pregunta   Pregunta    @relation(fields: [preguntaId], references: [id])
  respuestas Respuesta[]
}

// Representa una sesión de un usuario respondiendo un cuestionario
// calificacion se guarda aquí como desnormalización controlada para el reporte de gráfica
model Intento {
  id                     String        @id @default(cuid())
  cuestionarioId         String
  usuarioId              String
  calificacion           Float? // 0-100, se calcula y guarda al completar la calificación
  estado                 EstadoIntento @default(EN_PROGRESO)
  creadoEn               DateTime      @default(now())
  enviadoEn              DateTime? // Cuando el usuario entregó
  calificadoEn           DateTime? // Cuando quedó completamente calificado
  pausadoEn              DateTime? // Cuando IA pauso temporalmente el intento
  reactivadoEn           DateTime? // Cuando el alumno retomo un intento habilitado
  canceladoEn            DateTime? // Cuando admin/profesor confirmo cancelacion
  tiempoRestanteSegundos Int? // Segundos disponibles al pausar por revision IA

  // Relaciones
  cuestionario      Cuestionario       @relation(fields: [cuestionarioId], references: [id])
  usuario           Usuario            @relation(fields: [usuarioId], references: [id])
  respuestas        Respuesta[]
  alertasProctoring AlertaProctoring[]
}

model AlertaProctoring {
  id             String                   @id @default(cuid())
  intentoId      String
  estudianteId   String
  snapshotPath   String
  modelUsed      String
  aiResultJson   Json
  nivelAlerta    NivelAlertaProctoring
  confianza      Float
  estadoRevision EstadoRevisionProctoring @default(PENDIENTE)
  revisadoPorId  String?
  revisadoEn     DateTime?
  tipoEvidencia  TipoEvidenciaProctoring  @default(SNAPSHOT_CAMARA)
  driveFileId    String?
  driveWebViewLink String?
  creadoEn       DateTime                 @default(now())
  actualizadoEn  DateTime                 @updatedAt

  intento     Intento  @relation(fields: [intentoId], references: [id], onDelete: Cascade)
  estudiante  Usuario  @relation("AlertaProctoringEstudiante", fields: [estudianteId], references: [id])
  revisadoPor Usuario? @relation("AlertaProctoringRevisor", fields: [revisadoPorId], references: [id])

  @@index([intentoId])
  @@index([estudianteId])
  @@index([estadoRevision])
  @@index([nivelAlerta])
  @@index([intentoId, nivelAlerta])
}

// Respuesta de un usuario a una pregunta dentro de un intento
// - Si la pregunta es OPCION_MULTIPLE: se guarda opcionId, puntajeObtenido lo asigna el sistema
// - Si la pregunta es ABIERTA: se guarda respuestaAbierta, puntajeObtenido lo asigna el admin
// No se guarda esCorrecta aquí — se deriva comparando opcionId con Opcion.esCorrecta (3FN)
model Respuesta {
  id               String  @id @default(cuid())
  intentoId        String
  preguntaId       String
  opcionId         String? // Solo para OPCION_MULTIPLE
  respuestaAbierta String? // Solo para ABIERTA
  puntajeObtenido  Float? // null hasta que se califique

  // Relaciones
  intento  Intento  @relation(fields: [intentoId], references: [id])
  pregunta Pregunta @relation(fields: [preguntaId], references: [id])
  opcion   Opcion?  @relation(fields: [opcionId], references: [id])

  // Evita que existan dos respuestas para la misma pregunta dentro del mismo intento
  @@unique([intentoId, preguntaId])
}
